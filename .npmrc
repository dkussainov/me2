# pnpm hoisting rules for Expo SDK 54 compatibility.
#
# @expo/cli, expo-router, and metro internals call require.resolve() on
# transitive packages (metro-runtime, metro, metro-resolver, metro-config,
# metro-source-map, …) without declaring them as direct dependencies. Under
# pnpm's default isolated install those packages only live inside
# .pnpm/<pkg>/node_modules/, so Node's upward tree walk can't find them.
# Hoisting them to the workspace root node_modules keeps pnpm's isolation
# benefits for everything else while letting Expo CLI boot.
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=@react-native/*
public-hoist-pattern[]=react-native
