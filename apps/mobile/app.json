{
  "expo": {
    "name": "PADA",
    "slug": "me2",
    "version": "0.1.0",
    "scheme": "me2",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.me2.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "PADA needs the microphone to capture voice tasks.",
        "NSSpeechRecognitionUsageDescription": "PADA uses speech recognition to transcribe voice tasks.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.me2.app",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
