{
  "expo": {
    "name": "PADA",
    "slug": "me2",
    "version": "0.1.0",
    "scheme": "me2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "com.me2.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "PADA needs the microphone to capture voice tasks.",
        "NSSpeechRecognitionUsageDescription": "PADA uses speech recognition to transcribe voice tasks.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.me2.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090b"
      },
      "permissions": ["RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-speech",
        {
          "microphonePermission": "PADA needs the microphone to capture voice tasks."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
